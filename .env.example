# Copy to .env. Everything is optional: with no key the service starts, and photos already in
# cache/extractions/ (all 467 task photos) still work for predictions.csv.

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional backup provider (Groq, OpenAI-compatible API with a vision model)
# GROQ_API_KEY=your-groq-api-key-here

# Optional: model order and requests per minute, first is primary
# GEMINI_MODELS=gemini-3.5-flash-lite:10,gemini-3.8-flash:5
